# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging artifacts
build/
dist/
.eggs/
wheels/*
!wheels/.gitkeep
wheelhouse/*
!wheelhouse/.gitkeep

# Test and tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.ruff_cache/

# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Jupyter temporary files
.ipynb_checkpoints/

# Local datasets and generated encoded data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
datasets/
dataset/

# Model weights and temporary checkpoints
checkpoints/
outputs/
runs/
wandb/
mlruns/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Temporary experiment copies and local evaluation outputs
ScratchGPT-training/

# Generated tokenizer artifacts (keep project source and configs)
tokenizer.json
encoder.json
vocab.bpe

# Logs and temporary files
*.log
logs/
*.tmp
*.temp

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
